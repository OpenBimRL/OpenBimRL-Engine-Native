    name = "openbimrl_native",
    build_args = [
        "--verbose",
        "--parallel",
    ],
    build_data = [
        ":openbimrl_jni_jnibind",
        "@jni-bind//:all_srcs",
        "@jni-bind//:jni_bind.h",
        "@nlohmann_json_src//:CMakeLists.txt",
        "@nlohmann_json_src//:all_srcs",
